# MarketFlow API Configuration
APP_ENV=development
APP_NAME=marketflow-api

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=4000
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_URL=postgres://marketflow_user:YOUR_PASSWORD_HERE@localhost:5432/marketflow?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=8
POSTGRES_MAX_IDLE_CONNS=3
POSTGRES_CONN_MAX_LIFETIME=15m
POSTGRES_RUN_MIGRATIONS=true

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_NAMESPACE=marketflow

# Security (JWT validation via auth-api JWKS)
MF_SECURITY_JWKS_URL=https://sso.codevertexafrica.com/api/v1/.well-known/jwks.json
MF_SECURITY_JWT_ISSUER=https://sso.codevertexafrica.com
MF_SECURITY_JWT_AUDIENCE=codevertex
MF_SECURITY_REQUIRE_JWT=true

# NATS Events
MF_EVENTS_NATS_URL=nats://127.0.0.1:4222
MF_EVENTS_ENABLED=false
MF_EVENTS_OUTBOX_POLL_PERIOD=5s
MF_EVENTS_OUTBOX_BATCH_SIZE=100

# Meta Marketing API (optional)
MF_META_APP_ID=
MF_META_APP_SECRET=
MF_META_GRAPH_API_VERSION=v21.0

# AI / LLM (optional)
MF_AI_OLLAMA_URL=http://localhost:11434
MF_AI_OLLAMA_MODEL=llama3.1:8b
MF_AI_CLAUDE_API_KEY=
MF_AI_CLAUDE_MODEL=claude-haiku-4-5-20251001
MF_AI_EMBEDDING_MODEL=nomic-embed-text
MF_AI_EMBEDDING_DIM=768
