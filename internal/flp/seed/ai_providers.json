  "routing_strategy": {
    "description": "Two-tier model: fast classifier + quality responder",
    "flow": [
      {
        "step": 1,
        "model": "groq:llama-3.1-8b-instant",
        "purpose": "Classify question intent",
        "categories": ["simple_faq", "product_qa", "business_opportunity", "recruitment", "off_topic", "escalate"]
      },
      {
        "step": 2,
        "routing": {
          "simple_faq": "Return cached/template answer (no LLM call needed)",
          "product_qa": "groq:llama-3.3-70b-versatile + RAG context from pgvector",
          "business_opportunity": "groq:llama-3.3-70b-versatile + business opportunity seed data",
          "recruitment": "groq:llama-3.3-70b-versatile + recruitment templates",
          "off_topic": "Polite redirect template (no LLM call needed)",
          "escalate": "WhatsApp redirect to FBO (wa.me link)"
        }
      }
    ],
    "fallback_chain": [
      "groq:llama-3.3-70b-versatile",
      "groq:gemma2-9b-it",
      "ollama:llama3.1:8b",
      "anthropic:claude-haiku-4-5-20251001"
    ]
  },
  "caching_strategy": {
    "exact_match": {
      "key_format": "mf:chat:exact:{sha256(question+context)}",
      "ttl_hours": 24,
      "backend": "redis"
    },
    "semantic_cache": {
      "similarity_threshold": 0.95,
      "backend": "pgvector",
      "ttl_hours": 48
    },
    "template_cache": {
      "key_format": "mf:chat:template:{category}",
      "ttl_hours": 168,
      "backend": "redis"
    },
    "estimated_hit_rate": "40-60% for product Q&A"
  }
}
